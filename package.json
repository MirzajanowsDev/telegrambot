{
  "name": "generals-access-bot",
  "version": "2.0.0",
  "private": true,
  "description": "Telegram bot for product payments, manual receipt approval, and access delivery",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test",
    "dev:worker": "wrangler dev",
    "deploy": "wrangler deploy",
    "check:worker": "wrangler deploy --dry-run --outdir dist/worker",
    "db:migrate": "wrangler d1 migrations apply telegrambot --remote",
    "pretest": "npm run check:worker",
    "prepare:secrets": "node scripts/prepare-secrets.cjs",
    "upload:secrets": "wrangler secret bulk .wrangler/secrets.private.json",
    "cf:types": "wrangler types"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "telegraf": "4.16.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261025.1",
    "miniflare": "^5.20261019.2-beta",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "undici": "^7.30.1",
    "sharp": "^0.35.5"
  }
}
